# Copy to the ignored config/cloudflare/deploy.env. Requires Node.js >= 22.
# Supply CLOUDFLARE_API_TOKEN through your shell/CI secrets, or use wrangler login.
CLOUDFLARE_ACCOUNT_ID=
CF_FRONTEND_WORKER_NAME=colwork-frontend
CF_BACKEND_WORKER_NAME=colwork-backend
# Optional hostname-only custom domains. Leave empty for workers.dev URLs.
CF_FRONTEND_CUSTOM_DOMAIN=colwork.kuzuma.asia
CF_BACKEND_CUSTOM_DOMAIN=api.colwork.kuzuma.asia
